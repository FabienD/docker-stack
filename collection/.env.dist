DOMAIN=stack.local
DOCKER_NETWORK=stack_dev

# Traefik reverse proxy
TRAEFIK_VERSION=3.7

# SMTP Mail catcher
MAILCATCHER_VERSION=latest

# Redis
REDIS_VERSION=8

# RabbitMQ default credentials
RABBITMQ_VERSION=4-management
RABBITMQ_DEFAULT_VHOST=stack
RABBITMQ_DEFAULT_USER=stack
RABBITMQ_DEFAULT_PASSWORD=stack

# Postgresql
POSTGRESQL_VERSION=18
POSTGRES_PASSWORD=stack
POSTGRES_USER=stack
POSTGRES_DB=stack

# MySQL
MYSQL_VERSION=8-debian
MYSQL_ROOT_PASSWORD=stack
MYSQL_DATABASE=stack
MYSQL_USER=stack
MYSQL_PASSWORD=stack

# Loki
LOKI_VERSION=3.6.15
# Promtail is no longer released by Grafana past 3.6.11 (superseded by Alloy),
# hence the version gap with Loki above.
PROMTAIL_VERSION=3.6.11

# Rsyslog
RSYSLOG_VERSION=latest

# Grafana
GRAFANA_VERSION=13.0.2

# Portainer
PORTAINER_VERSION=latest
